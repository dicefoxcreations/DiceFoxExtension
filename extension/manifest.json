{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.4.46",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "130",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "pageCapture",
    "offscreen",
    "alarms",
    "unlimitedStorage",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_state": "disabled"
  },
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://*.dndbeyond.com/*",
    "https://media-waterdeep.cursecdn.com/*",
    "http://127.0.0.1/*"
  ],
  "side_panel": {
    "default_path": "popup.html"
  }
}
